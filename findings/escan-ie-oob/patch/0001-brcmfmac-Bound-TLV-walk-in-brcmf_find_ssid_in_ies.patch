From 691e41add5877f7305efd2e59fb353f9cfb7d59c Mon Sep 17 00:00:00 2001
From: mundur <nmondoo97@gmail.com>
Date: Wed, 19 Aug 2026 01:57:46 +0000
Subject: [PATCH] [brcmfmac] Bound TLV walk in brcmf_find_ssid_in_ies

Stop parsing when a TLV header or body would extend past ie_len to avoid
OOB reads on truncated IE buffers.

Test: host logic / existing driver unit coverage for length validation paths
Bug: None
Change-Id: Ia3e74c1cf0648d47129c58152cddba7b4a5e14ec
---
 .../drivers/third_party/broadcom/brcmfmac/cfg80211.cc    | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc b/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc
index 7be253e5799..87e552780e1 100644
--- a/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc
+++ b/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc
@@ -2138,12 +2138,15 @@ void brcmf_return_roam_conf(struct net_device* ndev, const uint8_t* selected_bss
 std::vector<uint8_t> brcmf_find_ssid_in_ies(const uint8_t* ie, size_t ie_len) {
   std::vector<uint8_t> ssid;
   size_t offset = 0;
-  while (offset < ie_len) {
+  while (offset + TLV_HDR_LEN <= ie_len) {
     uint8_t type = ie[offset];
     uint8_t length = ie[offset + TLV_LEN_OFF];
+    if (offset + TLV_HDR_LEN + length > ie_len) {
+      // Truncated IE — stop parsing rather than reading past ie_len.
+      break;
+    }
     if (type == WLAN_IE_TYPE_SSID) {
-      size_t ssid_len = std::min<size_t>(length, ie_len - (offset + TLV_HDR_LEN));
-      ssid_len = std::min<size_t>(ssid_len, fuchsia_wlan_ieee80211::kMaxSsidByteLen);
+      size_t ssid_len = std::min<size_t>(length, fuchsia_wlan_ieee80211::kMaxSsidByteLen);
       auto start = ie + offset + TLV_HDR_LEN;
       ssid = std::vector<uint8_t>(start, start + ssid_len);
       break;
