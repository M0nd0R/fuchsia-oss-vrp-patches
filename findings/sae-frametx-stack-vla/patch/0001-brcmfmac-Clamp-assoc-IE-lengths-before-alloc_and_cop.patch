From eeef83a219f56b0923149580efb477de8b987e1d Mon Sep 17 00:00:00 2001
From: mundur <nmondoo97@gmail.com>
Date: Wed, 19 Aug 2026 01:57:44 +0000
Subject: [PATCH] [brcmfmac] Clamp assoc IE lengths before alloc_and_copy

Reject firmware req_len/resp_len greater than WL_ASSOC_INFO_MAX so
brcmu_alloc_and_copy cannot read past cfg->extra_buf.

Test: host logic / existing driver unit coverage for length validation paths
Bug: None
Change-Id: I6f55902ed0272372cf54017cdff63b4a44a390de
---
 .../wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc b/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc
index 7be253e5799..de9f9cb77d3 100644
--- a/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc
+++ b/src/connectivity/wlan/drivers/third_party/broadcom/brcmfmac/cfg80211.cc
@@ -5784,6 +5784,13 @@ static zx_status_t brcmf_get_assoc_ies(struct brcmf_cfg80211_info* cfg, struct b
   assoc_info = (struct brcmf_cfg80211_assoc_ielen_le*)cfg->extra_buf;
   req_len = assoc_info->req_len;
   resp_len = assoc_info->resp_len;
+  // Firmware-supplied lengths must not exceed the iovar receive buffer; otherwise
+  // brcmu_alloc_and_copy() reads past cfg->extra_buf (CVE-2023-53213 class).
+  if (req_len > WL_ASSOC_INFO_MAX || resp_len > WL_ASSOC_INFO_MAX) {
+    BRCMF_ERR("Invalid assoc IE lengths from firmware: req_len=%u resp_len=%u max=%u", req_len,
+              resp_len, WL_ASSOC_INFO_MAX);
+    return ZX_ERR_IO_DATA_INTEGRITY;
+  }
   if (req_len) {
     err =
         brcmf_fil_iovar_data_get(ifp, "assoc_req_ies", cfg->extra_buf, WL_ASSOC_INFO_MAX, &fw_err);
-- 
2.47.3

